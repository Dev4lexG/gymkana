---
import Header from '@/components/Header.astro'

interface Props {
	title: string
}

const { title } = Astro.props
---

<!doctype html>
<html lang='es'>
	<head>
		<meta charset='UTF-8' />
		<meta name='description' content='Astro description' />
		<meta name='viewport' content='width=device-width' />
		<link rel='icon' type='image/svg+xml' href='/favicon.svg' />
		<meta name='generator' content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class='m-0 min-h-dvh bg-slate-950 dark text-slate-50'>
		<Header />
		<main class='mx-auto p-4 max-w-[1200px]'>
			<slot />
		</main>
	</body>
	<style is:global>
		@import url('/css/chillax.css');
		@import url('/css/tanker.css');

		main > * {
			margin-inline: auto;
		}

		:root {
			--c1: #e5bd02;
		}

		h1,
		h2,
		h3,
		h4 {
			text-wrap: balance;
		}

		p {
			text-wrap: pretty;
		}

		.truncate {
			white-space: normal !important;
		}
	</style>
</html>
