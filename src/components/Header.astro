---
import LinearBar from './LinearBar.astro'
---

<header>
	<div class='headingc expanded'>
		<div class='aaa'><a href='/'>Inicio</a></div>
		<div class='heading'>
			<div class='title'>
				<h1>
					<span>Gymkana</span>de Aroche
				</h1>
			</div>
			<div class='image'>
				<img src='/images/aroche.svg' width='90px' height='90px' />
			</div>
		</div>
		<div class='aaa'><a href='/gymkana'>Gymkana</a></div>
	</div>
	<div class='headingc n'>
		<div><a href='/'>Inicio</a></div>
		<div><a href='/gymkana'>Gymkana</a></div>
	</div>
	<LinearBar />
</header>

<style>
	header {
		font-family: 'Tanker-Regular';
		position: sticky;
		background-image: url(https://www.canalsur.es/resources/archivos_offline/2020/8/24/1598265527980aroche.jpg);
		background-position: center;
		background-size: cover;
		background-repeat: no-repeat;
	}
	header:before {
		content: '';
		position: absolute;
		top: 0;
		right: 0;
		bottom: 0;
		left: 0;
		background-image: linear-gradient(45deg, #060606a8, #17003387);
		z-index: -1;
	}

	.heading {
		display: flex;
		flex-direction: row;
		align-items: center;
		justify-content: center;
		padding: 10px;
	}
	.n {
		display: none !important;
		margin-top: -20px;
	}

	@media (max-width: 505px) {
		.aaa {
			display: none;
		}

		.n {
			display: flex !important;
		}
	}

	.headingc {
		display: flex;
		flex-direction: row;
		align-items: center;
		gap: 50px;
		justify-content: center;
		padding: 10px;
		font-size: 22px;
	}

	.title,
	.image {
	}

	h1 {
		margin: 0;
		color: aliceblue;
		letter-spacing: 4px;
		font-weight: 500;
		line-height: 35px;
		font-size: 32px;
	}

	span {
		font-size: 38px;
		display: block;
	}
</style>
