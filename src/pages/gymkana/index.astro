---
import { AccordionWrapper } from '@/components/NextUIWrapper'
import { gymkana as q } from '@/utils/config'
import Layout from '@/layouts/Layout.astro'
import { Button, Code, Link } from '@nextui-org/react'
import { Popup } from '@/components/Popup'
---

<Layout title='Inicio - Gymkana'>
	<Popup client:only />
	<h1 class='text-3xl'>Sobre la gymkana</h1>
	<p>
		La gymkana digital de Aroche es una actividad diseñada para que tanto
		visitantes como residentes puedan conocer mejor el patrimonio cultural,
		histórico y natural del pueblo a través de una serie de desafíos y preguntas
		interactivas. A lo largo del recorrido, los participantes se enfrentarán a
		diferentes tipos de pruebas que incluirán preguntas de opción múltiple,
		búsqueda de lugares emblemáticos y la resolución de enigmas relacionados con
		la historia local.
	</p>
	<h2 class='mt-4 text-2xl'>¿Qué temas vamos a tocar en esta gymkana? 😁</h2>

	<AccordionWrapper client:only sections={q} />

	<div class='flex flex-col justify-center'>
		<h4 class='text-xl mx-auto'>Te estamos esperando!</h4>

		<Button
			href={'/gymkana/' + q[0].urlName}
			as={Link}
			color='primary'
			variant='solid'
			className='my-4 w-40 mx-auto'
		>
			Empezar Gymkana
		</Button>
	</div>
</Layout>
