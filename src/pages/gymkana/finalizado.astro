---
import Layout from '../../layouts/Layout.astro'
import { Button, Link } from '@nextui-org/react'
---

<Layout title='Gymkana - Finalizado'>
	<div class='text-center mt-10 mb-5'>
		<h1>¡Terminastes esta gymkana!</h1>
	</div>
	<div class='flex flex-col justify-center'>
		<Button
			href='/gymkana'
			as={Link}
			color='primary'
			variant='solid'
			className='my-4 mx-auto w-40'
		>
			Volver a la gymkana
		</Button>
	</div>
</Layout>
<style>
	h1 {
		font-size: 35px;
	}
</style>
